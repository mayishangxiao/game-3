node_modules/
dist/
dist-ssr/
*.local
.DS_Store
.vite/
coverage/
*.log

# ---- 验证缓存区（截图 / CDP 报告 / Edge profile），随时可删可重建 ----
# 报告值得看，但不值得入库；重新跑 tools/cdp-*.mjs 会自动生成
tools/_cdp/
tools/_cdp2/
tools/_cdp3/
tools/_smoke/
tools/__pycache__/
__pycache__/

# Edge 远程调试用的临时 profile（体积大且含本机路径）
profile*/

# 例外：引导层两按钮 / 标题页按钮 / 小兵越界的专项探针是源码（判据写在文件里），其余 _cdp 脚本与输出仍忽略
!tools/_cdp/
tools/_cdp/*
!tools/_cdp/gate-buttons.mjs
!tools/_cdp/title-menu.mjs
!tools/_cdp/enemy-bounds.mjs
!tools/_cdp/gate-portrait.mjs
tools/_cdp/*/