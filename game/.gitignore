node_modules/
dist/
dist-ssr/
*.local
.DS_Store
.vite/
coverage/
*.log

# ---- 验证缓存区（截图 / CDP 报告 / Edge profile），随时可删可重建 ----
# 报告值得看，但不值得入库；重新跑 tools/cdp-*.mjs 会自动生成
tools/_cdp/
tools/_cdp2/
tools/_cdp3/
tools/_smoke/
tools/__pycache__/
__pycache__/

# Edge 远程调试用的临时 profile（体积大且含本机路径）
profile*/

# 例外：引导层两按钮 / 标题页按钮 / 小兵越界 / 炮火特效的专项探针是源码（判据写在文件里），其余 _cdp 脚本与输出仍忽略
!tools/_cdp/
tools/_cdp/*
!tools/_cdp/gate-buttons.mjs
!tools/_cdp/title-menu.mjs
!tools/_cdp/enemy-bounds.mjs
!tools/_cdp/gate-portrait.mjs
!tools/_cdp/cannon-fx.mjs
!tools/_cdp/wave-upgrade.mjs
tools/_cdp/*/
# 本轮新增的两个专项探针（场景布景 / 第一幕人工评审）：报告与截图仍不入库
!tools/_cdp/props-probe.mjs
!tools/_cdp/act1-shot.mjs

# 发布 staging：由 DEPLOY.md 的流程从 dist 重建，纯产物，不入库。
# 历史版本曾被误提交，用 `git rm -r --cached tools/_stage` 移出索引即可（工作区保留）。
tools/_stage/
