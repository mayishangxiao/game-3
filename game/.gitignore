node_modules/
dist/
dist-ssr/
*.local
.DS_Store
.vite/
coverage/
*.log

# ---- 验证缓存区（截图 / CDP 报告 / Edge profile），随时可删可重建 ----
# 报告值得看，但不值得入库；重新跑 tools/cdp-*.mjs 会自动生成
tools/_cdp/
tools/_cdp2/
tools/_cdp3/
tools/_smoke/
tools/__pycache__/
__pycache__/

# Edge 远程调试用的临时 profile（体积大且含本机路径）
profile*/

# 例外：引导层两按钮 / 标题页按钮 / 小兵越界 / 炮火特效的专项探针是源码（判据写在文件里），其余 _cdp 脚本与输出仍忽略
!tools/_cdp/
tools/_cdp/*
!tools/_cdp/gate-buttons.mjs
!tools/_cdp/title-menu.mjs
!tools/_cdp/enemy-bounds.mjs
!tools/_cdp/gate-portrait.mjs
!tools/_cdp/cannon-fx.mjs
!tools/_cdp/wave-upgrade.mjs
tools/_cdp/*/
# 本轮新增的两个专项探针（场景布景 / 第一幕人工评审）：报告与截图仍不入库
!tools/_cdp/props-probe.mjs
!tools/_cdp/act1-shot.mjs
# 战败重试 / 清箱回归探针（判据写在文件里，是源码；截图与 profile 仍忽略）
!tools/_cdp/tp-defeat.mjs
# 地图与远景背景实拍探针（v1.3 起带虎门对照组，防止城破之战新背景串场）
!tools/_cdp/tp-maps.mjs
# 装备存在感回归探针（v1.5：换装差值 / 强化禁用 / 掉落形状 / weapon_ref 手感）
!tools/_cdp/equip-presence.mjs
# 战斗内换武器回归探针（4.3.8：门禁 / 冻结 / 取消 / 重复 / 不可用 / 即时生效 / 战斗结束）
!tools/_cdp/weapon-swap.mjs
# 敌人贴墙卡死回归探针（v1.6：脚盒四角判据 / 出生点校正 / 贴墙绕行 / 救援恢复）
!tools/_cdp/enemy-stuck.mjs
# 开炮提示文案回归探针（v1.7.1：虎门保留史实名 / 天京与三个副本一律「重炮」/ toast 样式不变）
!tools/_cdp/cannon-label.mjs
# 开局武器选择 + 近战攻击向强化回归探针（v1.8：全程不被换弓 / 九张卡 / 组合技实拍）
!tools/_cdp/weapon-selection.mjs
# 右上角两枚按钮文字回归探针（v1.8.1：空框 / 缩放对齐 / 暂停与背包往返 / DOM 残留）
!tools/_cdp/top-buttons-label.mjs
# 关卡载入提示「载入中……」残留回归探针（v1.8.2：战斗稳态无残留 / 初始引导层提示保留）
!tools/_cdp/loading-text.mjs
# 主菜单（标题画面）实拍探针：确认标题场景激活 / #dom-title 可见 / 菜单按钮齐全 / 引导层已隐藏
!tools/_cdp/title-check.mjs
# 主菜单链路探针：标题 → 进战斗 → 暂停（含「返回主菜单」）→ 回标题，防止「主菜单消失」类回归
!tools/_cdp/title-flow.mjs
# 暴击震屏回归探针（太平天国战场：强度舒适区 / 一串暴击合并 / 效果未被删）
!tools/_cdp/crit-shake.mjs

# 发布 staging / 打包产物：由 DEPLOY.md 的流程从 dist 重建，纯产物，不入库。
# 历史版本曾被误提交，用 `git rm -r --cached tools/_stage` 移出索引即可（工作区保留）。
tools/_stage/
tools/_deploy_game.zip
